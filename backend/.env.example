# Copy to .env for local development. .env is git-ignored; never commit real values.
RELEASE_ASSISTANT_LOG_LEVEL=INFO
# Set to false locally for readable, colored console output.
RELEASE_ASSISTANT_LOG_JSON=true
# Only the in-memory mock exists so far.
RELEASE_ASSISTANT_BACKEND=mock
# The human account. The hash comes from `uv run release-assistant-hash-password`.
# Keep it in single quotes: it contains `$`. Change the password by generating a new hash
# and restarting; that also ends every login session.
# RELEASE_ASSISTANT_ADMIN_USERNAME=alice
# RELEASE_ASSISTANT_ADMIN_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=4$...'
# Login lasts this long without use (each use extends it), and a client address is locked
# out for the lockout time after this many failed attempts.
# RELEASE_ASSISTANT_ACCESS_TOKEN_TTL_MINUTES=480
# RELEASE_ASSISTANT_LOGIN_MAX_FAILURES=5
# RELEASE_ASSISTANT_LOGIN_LOCKOUT_MINUTES=15
# The agent's language model (OpenAI). The key is a SECRET: put it only in your own .env
# (git-ignored), never in this example file, in code or in a chat.
# RELEASE_ASSISTANT_OPENAI_API_KEY=
# Model name exactly as your OpenAI account lists it; check its current price before use.
# RELEASE_ASSISTANT_OPENAI_MODEL=gpt-5-mini
# minimal | low | medium | high. Lower is faster and cheaper. Leave unset if unsupported.
# RELEASE_ASSISTANT_OPENAI_REASONING_EFFORT=low
# RELEASE_ASSISTANT_OPENAI_MAX_OUTPUT_TOKENS=2000
# RELEASE_ASSISTANT_OPENAI_TIMEOUT_SECONDS=30
# Only for an OpenAI-compatible server (local model, gateway); leave unset for OpenAI itself.
# RELEASE_ASSISTANT_OPENAI_BASE_URL=
# Optional, dollars per million tokens, only to estimate the cost of evaluation runs. Take the
# current figures from OpenAI's pricing page; unset means no cost is shown.
# RELEASE_ASSISTANT_OPENAI_PRICE_INPUT_PER_MILLION=
# RELEASE_ASSISTANT_OPENAI_PRICE_OUTPUT_PER_MILLION=
# Client access. Interactive docs and the schema are off by default; browsers need an
# explicit origin (native apps do not). The API contract is committed in docs/openapi.json.
# RELEASE_ASSISTANT_DOCS_ENABLED=false
# RELEASE_ASSISTANT_CORS_ORIGINS=["https://app.example.com"]
# Abuse protection (ADR 0006). Defaults suit one operator plus one agent. Override any policy
# by name: ip, principal, login, propose, reports, reviews. A policy is "N/second|minute|hour",
# or several joined by ";" ("20/second;600/minute").
# RELEASE_ASSISTANT_RATE_LIMIT_ENABLED=true
# RELEASE_ASSISTANT_RATE_LIMITS={"login":"3/minute","reports":"10/minute"}
# Counters live in memory by default (one process). For several instances use Redis:
#   uv add "limits[async-redis]"  and  async+redis://localhost:6379
# RELEASE_ASSISTANT_RATE_LIMIT_STORAGE=async+memory://
# RELEASE_ASSISTANT_MAX_REQUEST_BYTES=65536
# Behind a reverse proxy, list its address so the real client address is used for limits.
# RELEASE_ASSISTANT_TRUSTED_PROXIES=127.0.0.1
# JSON list of API clients (static keys, meant for the agent). Store only the SHA-256 of each key:
#   printf '%s' "my-secret-key" | shasum -a 256
# Scopes: read, propose, confirm:button, confirm:voice (confirm scopes only for human UIs).
# "owner" is the account a client acts for; an agent and the user's app share it.
# RELEASE_ASSISTANT_API_CLIENTS=[{"subject":"ios-app","owner":"alice","key_sha256":"<64 hex chars>","scopes":["read","propose","confirm:button","confirm:voice"]},{"subject":"voice-agent","owner":"alice","key_sha256":"<64 hex chars>","scopes":["read","propose"]}]
